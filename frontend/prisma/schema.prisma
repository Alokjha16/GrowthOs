// GrowthOS — prisma/schema.prisma
// PostgreSQL + Supabase Connection Pooler
// Phase 1: Added Subscription, Entitlement, AutopilotPreferences, Finding,
//          PlaybookRun, Action, Task, AuditLog, Benchmark, AlertLog,
//          AlertPreferences, PlaybookAccuracy + storeCategory on Business

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // Port 6543 — transaction pooler (runtime queries)
  directUrl = env("DIRECT_URL")      // Port 5432 — session pooler (schema migrations)
}

// ─────────────────────────────────
// ENUMS — original
// ─────────────────────────────────

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SimulationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReportType {
  DIAGNOSIS
  SIMULATION
  EXECUTIVE_SUMMARY
}

enum BusinessType {
  ECOMMERCE
  RETAIL
  RESTAURANT
  SALON
  CONSULTING
  FITNESS
  HEALTHCARE
  AGENCY
  OTHER
}

enum PricingLevel {
  LOW
  MEDIUM
  HIGH
}

enum FulfillmentMethod {
  SELF_FULFILLED
  THREE_PL
  DROPSHIPPING
  HYBRID
}

// ─────────────────────────────────
// ENUMS — Phase 1 additions
// ─────────────────────────────────

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum EntitlementType {
  PLAN
  MODULE
}

enum EntitlementStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ModuleSlug {
  ADS
  PROFIT
  INVENTORY
  RETENTION
  CART_CRO
  FULFILLMENT
}

enum FindingConfidence {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum AutonomyLevel {
  SUGGEST
  APPROVE_EACH
  AUTO_RUN
}

enum PlaybookRunStatus {
  SHADOW
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  COMPLETED
  ROLLED_BACK
  FAILED
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTING
  COMPLETED
  FAILED
  ROLLED_BACK
  UNDONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DISMISSED
}

enum AlertChannel {
  EMAIL
  WHATSAPP
}

enum AlertStatus {
  SENT
  READ
  ACTIONED
  DISMISSED
}

enum BenchmarkSource {
  INDUSTRY_ESTIMATE
  AGGREGATED_USERS
}

// ─────────────────────────────────
// USER & AUTH
// ─────────────────────────────────

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?

  businesses    Business[]
  analyses      Analysis[]
  simulations   Simulation[]
  reports       Report[]

  accounts      Account[]
  sessions      Session[]

  // Phase 1 additions
  subscription     Subscription?
  entitlements     Entitlement[]
  autopilotPrefs   AutopilotPreferences?
  alertPrefs       AlertPreferences?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ─────────────────────────────────
// BUSINESS / STORE PROFILE
// ─────────────────────────────────

model Business {
  id                       String            @id @default(cuid())
  userId                   String

  name                     String
  businessType             BusinessType      @default(ECOMMERCE)
  industry                 String?
  storeCategory            String?           // "APPAREL" | "BEAUTY" | "HEALTH" | "HOME_DECOR" | "FOOD_BEVERAGE" | "OTHER"
  website                  String?
  description              String?

  monthlyRevenue           Decimal?          @db.Decimal(14, 2)
  monthlyExpenses          Decimal?          @db.Decimal(14, 2)
  customersPerMonth        Int?
  repeatCustomerPercentage Int?

  marketingChannels        String[]          @default([])
  pricingLevel             PricingLevel

  employeeCount            Int?
  healthScore              Int?

  averageOrderValue        Decimal?          @db.Decimal(10, 2)
  customerAcquisitionCost  Decimal?          @db.Decimal(10, 2)
  returnOnAdSpend          Decimal?          @db.Decimal(6, 2)
  cartAbandonmentRate      Int?
  inventoryTurnover        Decimal?          @db.Decimal(6, 2)
  fulfillmentMethod        FulfillmentMethod?
  returnRatePercentage     Int?

  // ── India-specific metrics ──────────────────────────────
  codRate                  Int?              // Cash on Delivery % (0–100)
  rtoRate                  Int?              // Return to Origin % (0–100)
  prepaidPercentage        Int?              // % of orders prepaid

  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses                 Analysis[]
  simulations              Simulation[]
  reports                  Report[]
  snapshots                BusinessSnapshot[]

  // Phase 1 additions
  findings                 Finding[]
  playbookRuns             PlaybookRun[]
  actions                  Action[]
  tasks                    Task[]
  auditLogs                AuditLog[]
  alertLogs                AlertLog[]

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([userId])
  @@index([businessType])
}

// ─────────────────────────────────
// HISTORICAL SNAPSHOTS
// ─────────────────────────────────

model BusinessSnapshot {
  id                       String   @id @default(cuid())
  businessId               String

  revenue                  Decimal? @db.Decimal(14, 2)
  expenses                 Decimal? @db.Decimal(14, 2)
  customers                Int?
  repeatRate               Int?
  healthScore              Int?

  averageOrderValue        Decimal? @db.Decimal(10, 2)
  customerAcquisitionCost  Decimal? @db.Decimal(10, 2)
  returnOnAdSpend          Decimal? @db.Decimal(6, 2)
  cartAbandonmentRate      Int?
  codRate                  Int?
  rtoRate                  Int?

  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())

  @@index([businessId, createdAt])
}

// ─────────────────────────────────
// ANALYSIS — 7-Agent Diagnosis Run
// ─────────────────────────────────

model Analysis {
  id              String         @id @default(cuid())
  businessId      String
  createdById     String?

  status          AnalysisStatus @default(PENDING)
  healthScore     Int?

  summary         Json?
  agents          Json?
  inputSnapshot   Json?

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reports         Report[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([businessId, createdAt])
  @@index([createdById])
}

// ─────────────────────────────────
// SIMULATION — Strategy Simulator Run
// ─────────────────────────────────

model Simulation {
  id               String           @id @default(cuid())
  businessId       String
  createdById      String?

  status           SimulationStatus @default(PENDING)
  strategy         String

  shortTermOutcome Json?
  longTermOutcome  Json?
  risks            Json?
  opportunities    Json?
  confidenceScore  Int?

  // Phase 1: link to a committed playbook run (for "Commit to this strategy")
  committedPlaybookRunId String?

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reports          Report[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([businessId, createdAt])
  @@index([createdById])
}

// ─────────────────────────────────
// REPORT — Executive CEO Report
// ─────────────────────────────────

model Report {
  id               String      @id @default(cuid())
  businessId       String
  createdById      String?
  analysisId       String?
  simulationId     String?

  type             ReportType
  title            String
  executiveSummary String?
  chiefRisk        String?
  topOpportunity   String?
  immediateAction  String?
  actionPlan       Json?

  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  analysis         Analysis?   @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  simulation       Simulation? @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([businessId, createdAt])
  @@index([analysisId])
  @@index([simulationId])
}

// ─────────────────────────────────
// NEXTAUTH ADAPTER TABLES
// ─────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────
// AGENT FEEDBACK — Training Data
// ─────────────────────────────────

model AgentFeedback {
  id         String   @id @default(cuid())
  analysisId String
  agentName  String
  rating     Int      // 1 = not useful · 5 = very useful
  comment    String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([analysisId])
  @@index([userId])
}

// ─────────────────────────────────
// RAG — Knowledge Base
// ─────────────────────────────────

model KnowledgeChunk {
  id        String   @id @default(cuid())
  content   String   @db.Text
  source    String   // e.g. "shiprocket_annual_report", "indian_d2c_playbook"
  category  String   // "marketing" | "operations" | "finance" | "retention"
  industry  String?  // "APPAREL" | "BEAUTY" etc — null means all industries
  createdAt DateTime @default(now())

  @@index([category])
  @@index([industry])
}

// ─────────────────────────────────
// PHASE 1: SUBSCRIPTION & ENTITLEMENTS
// ─────────────────────────────────

model Subscription {
  id               String      @id @default(cuid())
  userId           String      @unique
  planTier         PlanTier    @default(STARTER)
  billingCycle     String      @default("monthly")  // "monthly" | "annual"
  status           String      @default("active")   // "active" | "cancelled" | "paused"
  currentPeriodEnd DateTime?
  externalId       String?     // Razorpay subscription id — nullable until wired

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlements     Entitlement[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
}

model Entitlement {
  id             String            @id @default(cuid())
  userId         String
  subscriptionId String?
  type           EntitlementType   // PLAN | MODULE
  planTier       PlanTier?         // set when type=PLAN
  moduleSlug     ModuleSlug?       // set when type=MODULE (future standalone path)
  status         EntitlementStatus @default(ACTIVE)
  expiresAt      DateTime?

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt      DateTime          @default(now())

  @@index([userId, status])
  @@index([subscriptionId])
}

// ─────────────────────────────────
// PHASE 1: AUTOPILOT PREFERENCES
// ─────────────────────────────────

model AutopilotPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique

  // Kill switch & shadow mode
  killSwitchActive        Boolean  @default(false)
  shadowModeActive        Boolean  @default(true)   // New users start in shadow mode
  shadowModeStartedAt     DateTime @default(now())
  autoRollbackEnabled     Boolean  @default(false)

  // Guardrail defaults (founder can override)
  maxBudgetChangePct      Int      @default(20)
  maxPriceChangePct       Int      @default(10)
  maxDailyAdSpendShiftPct Int      @default(25)

  // Protected entity ids (campaigns / SKUs the founder marks untouchable)
  protectedEntityIds      String[] @default([])

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ─────────────────────────────────
// PHASE 1: FINDINGS
// ─────────────────────────────────

model Finding {
  id             String            @id @default(cuid())
  businessId     String
  moduleSlug     ModuleSlug

  title          String
  description    String            @db.Text

  // Money impact — deterministic, NEVER AI-generated
  moneyImpact    Decimal?          @db.Decimal(14, 2)   // monthly ₹ saved/gained
  impactFormula  String?           @db.Text             // human-readable formula string
  impactInputs   Json?                                  // { "adSpend": 62000, "roas": 0.7, ... }
  impactWindow   String?                                // "last 30 days"
  confidence     FindingConfidence @default(MEDIUM)

  // State
  dismissed      Boolean           @default(false)
  dismissedAt    DateTime?
  resolvedAt     DateTime?

  // Links
  playbookRunId  String?
  taskId         String?

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([businessId, moduleSlug])
  @@index([businessId, dismissed])
}

// ─────────────────────────────────
// PHASE 1: PLAYBOOK RUNS
// ─────────────────────────────────

model PlaybookRun {
  id               String            @id @default(cuid())
  businessId       String
  playbookSlug     String            // e.g. "pause-wasting-ad-sets"
  moduleSlug       ModuleSlug
  autonomyLevel    AutonomyLevel     @default(SUGGEST)
  status           PlaybookRunStatus @default(SHADOW)

  // One-tap approval via email/WhatsApp signed link
  approvalToken    String?           @unique
  tokenExpiresAt   DateTime?
  approvedAt       DateTime?
  approvedBy       String?           // userId

  // Shadow mode log
  shadowSavedAmount Decimal?         @db.Decimal(14, 2)
  shadowLog        Json?             // [{ action, wouldHaveDone, estimatedSaving }]

  // Verification schedule
  baselineSnapshot Json?
  verifyAt3d       DateTime?
  verifyAt14d      DateTime?
  verifyAt28d      DateTime?
  verificationResults Json?

  // Learning loop
  predictedImpact  Decimal?          @db.Decimal(14, 2)
  actualImpact     Decimal?          @db.Decimal(14, 2)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actions          Action[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([businessId, status])
  @@index([playbookSlug])
  @@index([approvalToken])
}

// ─────────────────────────────────
// PHASE 1: ACTIONS
// ─────────────────────────────────

model Action {
  id              String       @id @default(cuid())
  businessId      String
  playbookRunId   String?
  moduleSlug      ModuleSlug
  platform        String       // "shopify" | "meta_ads" | "manual"
  adapterAction   String       // e.g. "PAUSE_AD_SET" | "UPDATE_PRICE" | "ENABLE_PREPAID_ONLY"
  riskLevel       RiskLevel

  // State snapshot (for rollback & before/after display)
  beforeState     Json
  afterState      Json?

  // Money tracking
  predictedImpact Decimal?     @db.Decimal(14, 2)
  actualImpact    Decimal?     @db.Decimal(14, 2)

  status          ActionStatus  @default(PENDING)
  executedAt      DateTime?
  rolledBackAt    DateTime?
  rollbackReason  String?

  // Idempotency — same action can NEVER run twice
  idempotencyKey  String       @unique

  // Audit trail
  triggeredBy     String       // userId or "system"
  errorMessage    String?

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  playbookRun     PlaybookRun? @relation(fields: [playbookRunId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([businessId, status])
  @@index([playbookRunId])
  @@index([idempotencyKey])
}

// ─────────────────────────────────
// PHASE 1: TASKS (human-fallback)
// ─────────────────────────────────

model Task {
  id             String      @id @default(cuid())
  businessId     String
  moduleSlug     ModuleSlug?
  playbookRunId  String?

  title          String
  description    String?     @db.Text
  draftContent   String?     @db.Text  // ready-made email template / brief / checklist
  owner          String?               // free-text name or userId
  dueDate        DateTime?
  status         TaskStatus  @default(TODO)

  // Tracking
  targetMetric   String?
  baselineValue  Decimal?    @db.Decimal(14, 2)
  expectedImpact Decimal?    @db.Decimal(14, 2)
  actualImpact   Decimal?    @db.Decimal(14, 2)

  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([businessId, status])
  @@index([moduleSlug])
}

// ─────────────────────────────────
// PHASE 1: AUDIT LOG (immutable)
// ─────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  businessId     String
  userId         String?
  actionId       String?
  playbookRunId  String?

  event          String   // "ACTION_EXECUTED" | "ACTION_ROLLED_BACK" | "KILL_SWITCH_ON" | "APPROVAL_GRANTED" | ...
  platform       String?  // "shopify" | "meta_ads"
  entityType     String?  // "ad_set" | "sku" | "price" | "campaign"
  entityId       String?  // external id on the platform
  beforeState    Json?
  afterState     Json?
  metadata       Json?    // any extra context

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([actionId])
  @@index([playbookRunId])
}

// ─────────────────────────────────
// PHASE 1: BENCHMARKS
// ─────────────────────────────────

model Benchmark {
  id           String          @id @default(cuid())
  moduleSlug   ModuleSlug
  category     String          // store category e.g. "APPAREL" | "BEAUTY"
  metric       String          // e.g. "repeat_rate" | "roas" | "cac" | "rto_rate"
  p25          Decimal?        @db.Decimal(10, 4)
  median       Decimal?        @db.Decimal(10, 4)
  p75          Decimal?        @db.Decimal(10, 4)
  unit         String?         // "%" | "₹" | "x" | "days"
  source       BenchmarkSource @default(INDUSTRY_ESTIMATE)
  sourceLabel  String?         // "Industry estimate — Bain & Co D2C Report 2024"
  lastUpdated  DateTime        @default(now())

  @@unique([moduleSlug, category, metric])
  @@index([moduleSlug, category])
}

// ─────────────────────────────────
// PHASE 1: ALERT LOG
// ─────────────────────────────────

model AlertLog {
  id              String       @id @default(cuid())
  businessId      String
  userId          String
  channel         AlertChannel
  alertType       String       // "ROAS_DROP" | "STOCK_LOW" | "RTO_SPIKE" | "WEEKLY_DIGEST"
  moduleSlug      ModuleSlug?
  subject         String
  bodyHtml        String?      @db.Text
  approvalToken   String?      // one-time signed token embedded in alert
  tokenExpiresAt  DateTime?
  status          AlertStatus  @default(SENT)
  sentAt          DateTime     @default(now())
  // Deduplication — same alert won't repeat within 7 days unless metric worsens
  dedupKey        String?
  dedupExpiresAt  DateTime?

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, alertType, sentAt])
  @@index([dedupKey])
  @@index([approvalToken])
}

// ─────────────────────────────────
// PHASE 1: ALERT PREFERENCES
// ─────────────────────────────────

model AlertPreferences {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  emailEnabled                 Boolean  @default(true)
  whatsappEnabled              Boolean  @default(false)
  whatsappNumber               String?
  quietHoursStart              Int?     // 0–23, e.g. 22 (10 pm)
  quietHoursEnd                Int?     // 0–23, e.g. 8 (8 am)
  weeklyDigestDay              Int      @default(1)  // 1 = Monday

  // Alert thresholds
  roasDropThresholdPct         Int      @default(20)
  stockDaysThreshold           Int      @default(7)
  rtoSpikeThresholdPct         Int      @default(5)
  abandonmentSpikeThresholdPct Int      @default(10)

  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// ─────────────────────────────────
// PHASE 1: LEARNING LOOP
// ─────────────────────────────────

model PlaybookAccuracy {
  id             String     @id @default(cuid())
  playbookSlug   String
  moduleSlug     ModuleSlug
  totalRuns      Int        @default(0)
  accurateRuns   Int        @default(0)   // runs where actual was within 20% of predicted
  avgAccuracyPct Decimal?   @db.Decimal(6, 2)
  lastUpdated    DateTime   @default(now())

  @@unique([playbookSlug])
  @@index([moduleSlug])
}
